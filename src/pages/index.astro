---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: 'Vehicle Registration',
    desc: 'Out-of-state transfers and new plates handled start to finish. We file the paperwork, you walk out legal.',
  },
  {
    title: 'Title Transfers',
    desc: 'Commercial vehicles, private sales, inherited titles — whatever the chain, we cut through the DMV red tape.',
  },
  {
    title: 'Dealer Services',
    desc: 'Lien sales and dealer paperwork support for independent lots and private sellers across San Joaquin County.',
  },
  {
    title: 'Salvage Titles',
    desc: 'Salvage title processing and re-titling for rebuilt vehicles. We know the forms the DMV doesn\'t put on the website.',
  },
];
---

<Layout>
  <!-- ====== TOP NAV ====== -->
  <nav class="nav">
    <div class="nav-inner">
      <div>
        <span class="brand">GLAD</span>
        <span class="brand-sub">Auto Sales &amp; Services LLC</span>
      </div>
      <a href="tel:+12096015416" class="nav-cta">Call 209.601.5416</a>
    </div>
  </nav>

  <!-- ====== HERO ====== -->
  <header class="hero">
    <div class="container">
      <img
        src="/images/glad-logo-sign.jpg"
        alt="Glad Auto Sales & Services LLC — Gold SUV over bold green GLAD wordmark"
        class="hero-logo"
        width="520"
        height="520"
      />
      <h1>
        <span class="green">GLAD</span> Auto Sales<br />&amp; Services LLC
      </h1>
      <p class="tagline">
        San Joaquin County's trusted DMV partner for vehicle registration,
        title transfers, dealer services, and salvage titles.
      </p>
      <a href="tel:+12096015416" class="hero-cta">
        📞 Call 209.601.5416
      </a>
    </div>
  </header>

  <!-- ====== SERVICES ====== -->
  <section id="services">
    <div class="container">
      <div class="section-head">
        <h2>What <span>We Do</span></h2>
        <p>Four core services. We handle the paperwork the DMV doesn't make easy.</p>
      </div>
      <div class="services-grid">
        {services.map((s) => (
          <article class="service-card">
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== HOURS + LOCATIONS ====== -->
  <section id="visit">
    <div class="container">
      <div class="section-head">
        <h2>Come <span>Visit</span></h2>
        <p>Two locations, seven-day coverage. Walk-ins welcome during business hours.</p>
      </div>

      <div class="locations-grid">
        <!-- LODI -->
        <article class="location-card">
          <header class="location-head">
            <span class="location-tag">Lodi</span>
            <h3>617 E. Pine St</h3>
            <p class="location-addr">Lodi, CA 95240</p>
          </header>
          <div class="location-hours">
            <h4>Hours</h4>
            <p class="hours-days">Monday – Thursday</p>
            <p class="hours-time">12:00 PM – 5:30 PM</p>
            <p class="hours-closed">Closed Friday – Sunday</p>
          </div>
          <div class="location-map">
            <iframe
              src="https://www.openstreetmap.org/export/embed.html?bbox=-121.2660%2C38.1310%2C-121.2530%2C38.1380&amp;layer=mapnik&amp;marker=38.13449%2C-121.25964"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Glad Auto Sales & Services LLC — Lodi location, 617 E. Pine St"
              allowfullscreen
            ></iframe>
            <a href="https://www.openstreetmap.org/?mlat=38.13449&amp;mlon=-121.25964#map=17/38.13449/-121.25964" target="_blank" rel="noopener" class="map-link">
              Open in maps ↗
            </a>
          </div>
        </article>

        <!-- STOCKTON -->
        <article class="location-card">
          <header class="location-head">
            <span class="location-tag">Stockton</span>
            <h3>712 W. Swain Rd</h3>
            <p class="location-addr">Stockton, CA 95207</p>
          </header>
          <div class="location-hours">
            <h4>Hours</h4>
            <p class="hours-days">Friday – Sunday</p>
            <p class="hours-time">1:00 PM – 7:00 PM</p>
            <p class="hours-closed">Closed Mon – Thu</p>
            <span class="hours-highlight">★ Open Holidays</span>
          </div>
          <div class="location-map">
            <iframe
              src="https://www.openstreetmap.org/export/embed.html?bbox=-121.3250%2C38.0000%2C-121.3130%2C38.0080&amp;layer=mapnik&amp;marker=38.0041%2C-121.31917"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Glad Auto Sales & Services LLC — Stockton location, 712 W. Swain Rd"
              allowfullscreen
            ></iframe>
            <a href="https://www.openstreetmap.org/?mlat=38.0041&amp;mlon=-121.31917#map=17/38.0041/-121.31917" target="_blank" rel="noopener" class="map-link">
              Open in maps ↗
            </a>
          </div>
        </article>
      </div>

      <div class="contact-shared">
        <p>
          <strong>One phone, two locations:</strong>
          <a href="tel:+120****5416">209.601.5416</a>
          &nbsp;·&nbsp;
          <a href="mailto:gladautosllc@yahoo.com">gladautosllc@yahoo.com</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ====== CONTACT CTA ====== -->
  <section id="contact">
    <div class="container">
      <div class="section-head">
        <h2>Let's <span>Talk</span></h2>
        <p>One call clears up what would take you three trips to the DMV.</p>
      </div>
      <div class="contact-grid">
        <a href="tel:+120****5416" class="contact-card">
          <span class="label">Call Now</span>
          <span class="value">209.601.5416</span>
        </a>
        <a href="mailto:gladautosllc@yahoo.com" class="contact-card">
          <span class="label">Email</span>
          <span class="value">gladautosllc@yahoo.com</span>
        </a>
        <a href="https://www.openstreetmap.org/?mlat=38.13449&mlon=-121.25964#map=17/38.13449/-121.25964" target="_blank" rel="noopener" class="contact-card">
          <span class="label">Lodi</span>
          <span class="value">617 E. Pine St</span>
        </a>
        <a href="https://www.openstreetmap.org/?mlat=38.0041&mlon=-121.31917#map=17/38.0041/-121.31917" target="_blank" rel="noopener" class="contact-card">
          <span class="label">Stockton</span>
          <span class="value">712 W. Swain Rd</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ====== FOOTER ====== -->
  <footer>
    <div class="container">
      <p>
        <span class="gold">GLAD</span> Auto Sales &amp; Services LLC
      </p>
      <p style="margin-top:.5rem;">
        <strong>Lodi:</strong> 617 E. Pine St, Lodi, CA 95240 &nbsp;·&nbsp; Mon–Thu 12–5:30 PM
      </p>
      <p>
        <strong>Stockton:</strong> 712 W. Swain Rd, Stockton, CA 95207 &nbsp;·&nbsp; Fri–Sun + Holidays 1–7 PM
      </p>
      <p style="margin-top:.5rem;">
        <a href="tel:+120****5416">209.601.5416</a>
        &nbsp;·&nbsp;
        <a href="mailto:gladautosllc@yahoo.com">gladautosllc@yahoo.com</a>
      </p>
      <p style="margin-top:1rem;font-size:.8rem;">
        © {new Date().getFullYear()} Glad Auto Sales &amp; Services LLC. All rights reserved.
      </p>
    </div>
  </footer>
</Layout>
