---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: 'Vehicle Registration',
    desc: 'Out-of-state transfers and new plates handled start to finish. We file the paperwork, you walk out legal.',
  },
  {
    title: 'Title Transfers',
    desc: 'Commercial vehicles, private sales, inherited titles — whatever the chain, we handle the title work so you don\'t have to.',
  },
  {
    title: 'Dealer Services',
    desc: 'Lien sales and dealer paperwork support for independent lots and private sellers across California.',
  },
  {
    title: 'Salvage Titles',
    desc: 'Salvage title processing and re-titling for rebuilt vehicles. We know the forms most people never see.',
  },
];
---

<Layout>
  <!-- ====== TOP NAV ====== -->
  <nav class="nav">
    <div class="nav-inner">
      <div>
        <span class="brand">GLAD</span>
        <span class="brand-sub">Auto Sales &amp; Services LLC</span>
      </div>
      <a href="tel:+12096015416" class="nav-cta">Call 209.601.5416</a>
    </div>
  </nav>

  <!-- ====== HERO ====== -->
  <header class="hero">
    <div class="container">
      <img
        src="/images/glad-logo-sign.jpg"
        alt="Glad Auto Sales & Services LLC — Gold SUV over bold green GLAD wordmark"
        class="hero-logo"
        width="520"
        height="520"
      />
      <h1>
        <span class="green">GLAD</span> Auto Sales<br />&amp; Services LLC
      </h1>
      <p class="tagline">
        Walk in, get it done. Two California locations handling vehicle registration and title work — no appointment needed.
      </p>
      <a href="tel:+12096015416" class="hero-cta">
        📞 Call 209.601.5416
      </a>

      <!-- ====== COMPARE TABLE: Us vs The Other Guys ====== -->
      <div class="compare-wrap">
        <table class="compare-table">
          <thead>
            <tr>
              <th></th>
              <th class="us-col">Glad Auto</th>
              <th>The Other Guys</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Appointment needed?</td>
              <td class="us-col"><span class="check">✓</span> No</td>
              <td>Yes, often</td>
            </tr>
            <tr>
              <td>Typical wait</td>
              <td class="us-col"><span class="check">✓</span> 15–30 min</td>
              <td>Hours</td>
            </tr>
            <tr>
              <td>Two locations, seven-day coverage</td>
              <td class="us-col"><span class="check">✓</span> Yes</td>
              <td>Not always</td>
            </tr>
            <tr>
              <td>Forms and paperwork handled for you</td>
              <td class="us-col"><span class="check">✓</span> Yes</td>
              <td>Bring your own</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </header>

  <!-- ====== SERVICES ====== -->
  <section id="services">
    <div class="container">
      <div class="section-head">
        <h2>What <span>We Do</span></h2>
        <p>Four core services. We handle the paperwork so you don't have to.</p>
      </div>
      <div class="services-grid">
        {services.map((s) => (
          <article class="service-card">
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== FAQ ====== -->
  <section id="faq">
    <div class="container">
      <div class="section-head">
        <h2>Common <span>Questions</span></h2>
        <p>The things people ask us most often.</p>
      </div>
      <div class="faq-grid">
        <details class="faq-item" open>
          <summary>Do I need an appointment?</summary>
          <p>No. Walk in any time we're open — both locations handle drop-ins.</p>
        </details>
        <details class="faq-item">
          <summary>What should I bring with me?</summary>
          <p>Depends on the service. Call <a href="tel:+120****5416">209.601.5416</a> first and we'll tell you exactly what to bring for your specific paperwork — saves you a second trip.</p>
        </details>
        <details class="faq-item">
          <summary>How long does a typical visit take?</summary>
          <p>Most visits are done in 15–30 minutes once we start your paperwork.</p>
        </details>
        <details class="faq-item">
          <summary>Do you handle out-of-state vehicles?</summary>
          <p>Yes — out-of-state transfers and new plates are one of our core services.</p>
        </details>
        <details class="faq-item">
          <summary>Can you help with salvage titles?</summary>
          <p>Yes. We process salvage title paperwork and re-titling for rebuilt vehicles.</p>
        </details>
        <details class="faq-item">
          <summary>Are you a dealer? Can you help with lien sales?</summary>
          <p>Yes. We support independent lots and private sellers across California with dealer paperwork, lien sales, and transfers.</p>
        </details>
        <details class="faq-item">
          <summary>Which location should I go to?</summary>
          <p>Lodi (617 E. Pine St) is open Mon–Thu 12–5:30 PM. Stockton (712 W. Swain Rd) is open Fri–Sun + holidays 1–7 PM. Seven-day coverage between the two.</p>
        </details>
        <details class="faq-item">
          <summary>Is Glad Auto affiliated with the state DMV?</summary>
          <p>No. Glad Auto Sales &amp; Services LLC is a privately owned business. We are not a state agency, and we do not issue driver's licenses or identification cards. We are a private registration service that handles DMV paperwork on your behalf.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- ====== HOURS + LOCATIONS ====== -->
  <section id="visit">
    <div class="container">
      <div class="section-head">
        <h2>Come <span>Visit</span></h2>
        <p>Two locations, seven-day coverage. Walk-ins welcome during business hours.</p>
      </div>

      <div class="locations-grid">
        <!-- LODI -->
        <article class="location-card">
          <header class="location-head">
            <span class="location-tag">Lodi</span>
            <h3>617 E. Pine St</h3>
            <p class="location-addr">Lodi, CA 95240</p>
          </header>
          <div class="location-hours">
            <h4>Hours</h4>
            <p class="hours-days">Monday – Thursday</p>
            <p class="hours-time">12:00 PM – 5:30 PM</p>
            <p class="hours-closed">Closed Friday – Sunday</p>
          </div>
          <div class="location-map">
            <iframe
              src="https://maps.google.com/maps?q=617+E+Pine+St%2C+Lodi%2C+CA+95240&z=15&output=embed"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Glad Auto Sales & Services LLC — Lodi location, 617 E. Pine St"
              allowfullscreen
            ></iframe>
            <a href="https://www.google.com/maps/dir/?api=1&destination=617+E+Pine+St%2C+Lodi%2C+CA+95240" target="_blank" rel="noopener" class="map-link">
              Get directions ↗
            </a>
          </div>
        </article>

        <!-- STOCKTON -->
        <article class="location-card">
          <header class="location-head">
            <span class="location-tag">Stockton</span>
            <h3>712 W. Swain Rd</h3>
            <p class="location-addr">Stockton, CA 95207</p>
          </header>
          <div class="location-hours">
            <h4>Hours</h4>
            <p class="hours-days">Friday – Sunday</p>
            <p class="hours-time">1:00 PM – 7:00 PM</p>
            <p class="hours-closed">Closed Mon – Thu</p>
            <span class="hours-highlight">★ Open Holidays</span>
          </div>
          <div class="location-map">
            <iframe
              src="https://maps.google.com/maps?q=712+W+Swain+Rd%2C+Stockton%2C+CA+95207&z=15&output=embed"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Glad Auto Sales & Services LLC — Stockton location, 712 W. Swain Rd"
              allowfullscreen
            ></iframe>
            <a href="https://www.google.com/maps/dir/?api=1&destination=712+W+Swain+Rd%2C+Stockton%2C+CA+95207" target="_blank" rel="noopener" class="map-link">
              Get directions ↗
            </a>
          </div>
        </article>
      </div>

      <div class="contact-shared">
        <p>
          <strong>One phone, two locations:</strong>
          <a href="tel:+120****5416">209.601.5416</a>
          &nbsp;·&nbsp;
          <a href="mailto:gladautosllc@yahoo.com">gladautosllc@yahoo.com</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ====== CONTACT CTA ====== -->
  <section id="contact">
    <div class="container">
      <div class="section-head">
        <h2>Let's <span>Talk</span></h2>
        <p>One call clears up your registration, title, or paperwork — fast.</p>
      </div>
      <div class="contact-grid">
        <a href="tel:+120****5416" class="contact-card">
          <span class="label">Call Now</span>
          <span class="value is-long">209.601.5416</span>
        </a>
        <a href="mailto:gladautosllc@yahoo.com" class="contact-card">
          <span class="label">Email</span>
          <span class="value is-long">gladautosllc@yahoo.com</span>
        </a>
        <a href="https://www.google.com/maps/dir/?api=1&destination=617+E+Pine+St%2C+Lodi%2C+CA+95240" target="_blank" rel="noopener" class="contact-card">
          <span class="label">Lodi</span>
          <span class="value">617 E. Pine St</span>
        </a>
        <a href="https://www.google.com/maps/dir/?api=1&destination=712+W+Swain+Rd%2C+Stockton%2C+CA+95207" target="_blank" rel="noopener" class="contact-card">
          <span class="label">Stockton</span>
          <span class="value">712 W. Swain Rd</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ====== FOOTER ====== -->
  <footer>
    <div class="container">
      <p>
        <span class="gold">GLAD</span> Auto Sales &amp; Services LLC
      </p>
      <p style="margin-top:.5rem;">
        <strong>Lodi:</strong> 617 E. Pine St, Lodi, CA 95240 &nbsp;·&nbsp; Mon–Thu 12–5:30 PM
      </p>
      <p>
        <strong>Stockton:</strong> 712 W. Swain Rd, Stockton, CA 95207 &nbsp;·&nbsp; Fri–Sun + Holidays 1–7 PM
      </p>
      <p style="margin-top:.5rem;">
        <a href="tel:+120****5416">209.601.5416</a>
        &nbsp;·&nbsp;
        <a href="mailto:gladautosllc@yahoo.com">gladautosllc@yahoo.com</a>
      </p>
      <p style="margin-top:1rem;font-size:.85rem;">
        Serving <strong>Lodi, Stockton, Manteca, Tracy, Modesto, Galt, Elk Grove</strong> and the Central Valley.
      </p>
      <p class="disclaimer" style="margin-top:1rem;font-size:.75rem;color:var(--muted);line-height:1.5;">
        Glad Auto Sales &amp; Services LLC is a privately owned business and is <strong>not affiliated with the California Department of Motor Vehicles</strong> or any state agency. We do not issue driver's licenses or identification cards. Service fees are charged in addition to any state fees.
      </p>
      <p style="margin-top:1rem;font-size:.8rem;">
        © {new Date().getFullYear()} Glad Auto Sales &amp; Services LLC. All rights reserved.
      </p>
    </div>
  </footer>
</Layout>
